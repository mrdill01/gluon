]

io.print_ln "n=" & RUN_TIMES
start = time.clock;
array.iter: tests, (fun item -> do
	if (value.type_of: item) is value.type.Function do
		name = text.right_pad: (as_text: item), 35, "."
		name <- text.replace_all: name, "testbench.lur/", ""
		name <- text.replace_all: name, "(0)", ""
		name <- "    " & name
		io.print: name
		
		times = []
		loop: RUN_TIMES, (fun _ -> do
			start = time.clock;
			item;
			times &= time.clock; - start
		end)
	
		took = array.sum: times
		io.print_ln: "took " & took & "s"
	end else io.print_ln: item
end)
io.print_ln: "success! took " & (time.clock; - start) & "s"
